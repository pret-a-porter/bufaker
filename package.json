{
  "name": "bufaker",
  "version": "0.1.0",
  "description": "Generate realistic mock data for any Protobuf message from its protobuf-es runtime descriptor, powered by Faker.",
  "keywords": [
    "protobuf",
    "proto",
    "buf",
    "bufbuild",
    "protobuf-es",
    "faker",
    "mock",
    "fixtures",
    "testing"
  ],
  "author": "Maksim Sharipov",
  "homepage": "https://github.com/pret-a-porter/bufaker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pret-a-porter/bufaker.git"
  },
  "bugs": {
    "url": "https://github.com/pret-a-porter/bufaker/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "generate": "buf generate",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.2.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@bufbuild/protobuf": "^2.2.0",
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "expect-type": "^1.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@bufbuild/buf@1.73.0": true,
    "esbuild@0.28.2": true
  }
}
